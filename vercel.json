{
    "version": 2,
    "cleanUrls": true,
    "trailingSlash": false,
    "routes": [
        {
            "src": "/api/kiwify-webhook",
            "dest": "/api/kiwify-webhook.ts"
        },
        {
            "src": "/api/activate",
            "dest": "/api/activate.ts"
        },
        {
            "src": "/api/validate",
            "dest": "/api/validate.ts"
        },
        {
            "src": "/api/search",
            "dest": "/api/search.ts"
        },
        {
            "src": "/api/test",
            "dest": "/api/test.ts"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}