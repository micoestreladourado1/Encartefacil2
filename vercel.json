{
    "version": 2,
    "functions": {
        "api/**/*.ts": {
            "runtime": "@vercel/node"
        }
    },
    "rewrites": [
        {
            "source": "/api/kiwify-webhook",
            "destination": "/api/kiwify-webhook.ts"
        },
        {
            "source": "/api/activate",
            "destination": "/api/activate.ts"
        },
        {
            "source": "/api/validate",
            "destination": "/api/validate.ts"
        },
        {
            "source": "/api/search",
            "destination": "/api/search.ts"
        },
        {
            "source": "/api/test",
            "destination": "/api/test.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}